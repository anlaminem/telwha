{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "survey-result-short-v1.json",
  "title": "Survey Result Payload — Short Form V1",
  "type": "object",
  "required": [
    "response_id",
    "survey_version",
    "scoring_version",
    "metadata",
    "raw_answers"
  ],
  "properties": {
    "response_id": {
      "type": "string",
      "minLength": 1
    },
    "survey_version": {
      "type": "string",
      "const": "short-v1"
    },
    "scoring_version": {
      "type": "string",
      "const": "short-heuristic-v1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "duration_seconds",
        "completion_status",
        "answered_count",
        "required_count"
      ],
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "completion_status": {
          "type": "string",
          "enum": ["completed", "partial", "abandoned"]
        },
        "answered_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33
        },
        "required_count": {
          "type": "integer",
          "const": 33
        },
        "location_group": {
          "type": ["string", "null"]
        },
        "employment_type": {
          "type": ["string", "null"]
        },
        "routing_flags": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "raw_answers": {
      "type": "object",
      "properties": {
        "FA1": { "$ref": "#/$defs/catAnswer" },
        "FA2": { "$ref": "#/$defs/catAnswer" },
        "FA3": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA4": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA5": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA6": { "$ref": "#/$defs/catAnswer" },
        "FA7": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA8": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA9": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FA10": { "$ref": "#/$defs/scaleAnswer1to5" },

        "PA1": { "$ref": "#/$defs/catAnswer" },
        "PA2": { "$ref": "#/$defs/scaleAnswer0to4" },
        "PA3": { "$ref": "#/$defs/scaleAnswer1to5" },
        "PA4": { "$ref": "#/$defs/scaleAnswer1to5" },
        "PA5": { "$ref": "#/$defs/catAnswer" },
        "PA6": { "$ref": "#/$defs/scaleAnswer1to5" },
        "PA7": { "$ref": "#/$defs/scaleAnswer1to5" },
        "PA8": { "$ref": "#/$defs/scaleAnswer1to5" },

        "FH1": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH2": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH3": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH4": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH5": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH6": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH7": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH8": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH9": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH10": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH11": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH12": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH13": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH14": { "$ref": "#/$defs/scaleAnswer1to5" },
        "FH15": { "$ref": "#/$defs/scaleAnswer1to5" }
      },
      "additionalProperties": false
    },
    "derived_scores": {
      "type": "object",
      "required": [
        "reserve_index_1_5",
        "debt_index_1_5",
        "chaos_index_1_5",
        "visibility_index_1_5",
        "pressure_index_1_5",
        "income_control_index_1_5"
      ],
      "properties": {
        "reserve_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "debt_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "chaos_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "visibility_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "pressure_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "income_control_index_1_5": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "pa1_option_code": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "pa5_option_code": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "income_sources_raw_0_4": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "archetype_result": {
      "type": "object",
      "required": [
        "primary_id",
        "primary_name",
        "mix_flag",
        "rule_fired"
      ],
      "properties": {
        "primary_id": {
          "type": "string",
          "enum": [
            "ZP_CLUSTER",
            "SK_CLUSTER",
            "FS_CLUSTER",
            "PN_CLUSTER",
            "VV_CLUSTER",
            "TS_CLUSTER"
          ]
        },
        "primary_name": {
          "type": "string",
          "enum": [
            "Кластер виживального гасіння дірок",
            "Кластер сімейних та системних сценаріїв",
            "Кластер уникання фінансової реальності",
            "Кластер «планую, але не роблю»",
            "Кластер вигорання і тиску",
            "Кластер сейфу, контролю і заморожених рішень"
          ]
        },
        "mix_flag": {
          "type": "boolean"
        },
        "rule_fired": {
          "type": "string",
          "enum": [
            "zp_cluster_rule",
            "sk_cluster_rule",
            "fs_cluster_rule",
            "pn_cluster_rule",
            "vv_cluster_rule",
            "ts_cluster_rule"
          ]
        },
        "secondary_id": {
          "type": ["string", "null"],
          "enum": [
            "ZP_CLUSTER",
            "SK_CLUSTER",
            "FS_CLUSTER",
            "PN_CLUSTER",
            "VV_CLUSTER",
            "TS_CLUSTER",
            null
          ]
        },
        "secondary_name": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": ["string", "null"],
          "enum": ["low", "medium", "high", null]
        },
        "debug_snapshot": {
          "type": "object",
          "properties": {
            "reserve_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "debt_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "chaos_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "visibility_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "pressure_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "income_control_index_1_5": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "pa1_option_code": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 5
            },
            "pa5_option_code": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 5
            },
            "income_sources_raw_0_4": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 4
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "user_report": {
      "type": "object",
      "properties": {
        "report_title": { "type": ["string", "null"] },
        "report_summary_short": { "type": ["string", "null"] },
        "report_summary_long": { "type": ["string", "null"] },
        "top_strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_best_action": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "completion_status": { "const": "completed" }
            },
            "required": ["completion_status"]
          }
        }
      },
      "then": {
        "required": ["derived_scores", "archetype_result"],
        "properties": {
          "metadata": {
            "properties": {
              "answered_count": { "const": 33 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "catAnswer": {
      "type": "object",
      "required": ["item_id", "raw", "option_code"],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "raw": {
          "type": "null"
        },
        "option_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "scaleAnswer1to5": {
      "type": "object",
      "required": ["item_id", "raw", "option_code"],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "raw": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "option_code": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "scaleAnswer0to4": {
      "type": "object",
      "required": ["item_id", "raw", "option_code"],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "option_code": {
          "type": "null"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}